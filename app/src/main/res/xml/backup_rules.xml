<?xml version="1.0" encoding="utf-8"?>
<!--
    What Android may back up, for Android 11 and earlier (Android 12 and later read
    data_extraction_rules.xml instead; the manifest names both).

    The database holds the user's accounts and transactions: the app promises that it keeps them on the
    device, so it is left out of the backup. "domain=database" is the app's whole database folder, which
    covers cents.db and the -wal / -shm / -journal / .lck files kept next to it.
-->
<full-backup-content>
    <exclude domain="database" path="." />
</full-backup-content>
