<?xml version="1.0" encoding="utf-8"?>
<!--
    What Android may copy off the phone, for Android 12 and later
    (see https://developer.android.com/about/versions/12/backup-restore).

    The database holds the user's accounts and transactions: the app promises that it keeps them on the
    device, so it is left out of the cloud backup (the copy of the phone's data that goes to the user's
    Google account). "domain=database" is the app's whole database folder, which covers cents.db and the
    -wal / -shm / -journal / .lck files Room and SQLite keep next to it.

    Copying the data straight from one phone to another during a setup (device-transfer) is not covered
    by this: it never goes through the cloud, so it is left as it is by default.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
    </cloud-backup>
</data-extraction-rules>
